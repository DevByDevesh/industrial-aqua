rules_version = '2';

// Industrial Aqua — Firestore security rules (source of truth, versioned
// with the site). Publish via Firebase Console (Firestore Database → Rules)
// or `firebase deploy --only firestore:rules` — see docs/firebase-setup.md.
//
// Model:
// - products: public read; writes only by the store admin account, and
//   every write must match the product schema (no invented fields, no
//   negative prices or stock).
// - orders: a signed-in customer creates an order only for themselves, in
//   the initial status and initial payment state ('Pending'), with a
//   strictly validated shape. Customers read only their own orders. Only
//   the admin can change an order afterwards, and only its status /
//   paymentStatus (+ updatedAt) — items and totals are immutable, and a
//   customer can never mark their own order as paid.
// - everything else: denied.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.email == 'yadavrajan7572@gmail.com';
    }

    // ---------------- products ----------------

    function validProduct(data) {
      return data.keys().hasOnly([
          'slug', 'name', 'code', 'section', 'subsection', 'specs',
          'description', 'price', 'stock', 'order', 'updatedAt'
        ])
        && data.keys().hasAll(['slug', 'name', 'section', 'specs', 'price'])
        && data.slug is string && data.slug.size() > 0 && data.slug.size() <= 200
        && data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && data.section is string && data.section.size() > 0 && data.section.size() <= 60
        && (!('code' in data) || (data.code is string && data.code.size() <= 60))
        && (!('subsection' in data) || (data.subsection is string && data.subsection.size() <= 80))
        && (!('description' in data) || (data.description is string && data.description.size() <= 4000))
        && data.specs is list && data.specs.size() <= 30
        && (data.price == null || (data.price is number && data.price >= 0))
        && (!('stock' in data) || data.stock == null || (data.stock is int && data.stock >= 0))
        && (!('order' in data) || data.order is number)
        && (!('updatedAt' in data) || data.updatedAt is string);
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update: if isAdmin() && validProduct(request.resource.data);
      allow delete: if isAdmin();
    }

    // ---------------- orders ----------------

    function validItem(item) {
      return item is map
        && item.keys().hasOnly(['slug', 'name', 'code', 'qty', 'price'])
        && item.keys().hasAll(['slug', 'name', 'qty', 'price'])
        && item.slug is string && item.slug.size() > 0 && item.slug.size() <= 200
        && item.name is string && item.name.size() > 0 && item.name.size() <= 200
        && (!('code' in item) || (item.code is string && item.code.size() <= 60))
        && item.qty is int && item.qty >= 1 && item.qty <= 99
        && (item.price == null || (item.price is number && item.price >= 0));
    }

    // Firestore rules forbid recursive calls, so per-item validation is
    // unrolled: validItemAt passes for indexes beyond the list size, and
    // the create check below chains it for the maximum 50 items.
    function validItemAt(items, i) {
      return i >= items.size() || validItem(items[i]);
    }

    function validNewOrder(data) {
      return data.keys().hasOnly([
          'userId', 'email', 'customer', 'items', 'pricedTotal',
          'hasUnpricedItems', 'status', 'paymentStatus', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasAll([
          'userId', 'email', 'customer', 'items', 'pricedTotal',
          'hasUnpricedItems', 'status', 'paymentStatus', 'createdAt', 'updatedAt'
        ])
        && data.userId == request.auth.uid
        && data.email == request.auth.token.email
        && data.status == 'Sent to store on WhatsApp'
        && data.paymentStatus == 'Pending'
        && data.customer is map
        && data.customer.keys().hasOnly(['name', 'phone', 'address'])
        && data.customer.keys().hasAll(['name', 'phone', 'address'])
        && data.customer.name is string && data.customer.name.size() > 0 && data.customer.name.size() <= 120
        && data.customer.phone is string && data.customer.phone.size() > 0 && data.customer.phone.size() <= 30
        && data.customer.address is string && data.customer.address.size() > 0 && data.customer.address.size() <= 600
        && data.items is list && data.items.size() >= 1 && data.items.size() <= 50
        && validItemAt(data.items, 0) &&
        validItemAt(data.items, 1) &&
        validItemAt(data.items, 2) &&
        validItemAt(data.items, 3) &&
        validItemAt(data.items, 4) &&
        validItemAt(data.items, 5) &&
        validItemAt(data.items, 6) &&
        validItemAt(data.items, 7) &&
        validItemAt(data.items, 8) &&
        validItemAt(data.items, 9) &&
        validItemAt(data.items, 10) &&
        validItemAt(data.items, 11) &&
        validItemAt(data.items, 12) &&
        validItemAt(data.items, 13) &&
        validItemAt(data.items, 14) &&
        validItemAt(data.items, 15) &&
        validItemAt(data.items, 16) &&
        validItemAt(data.items, 17) &&
        validItemAt(data.items, 18) &&
        validItemAt(data.items, 19) &&
        validItemAt(data.items, 20) &&
        validItemAt(data.items, 21) &&
        validItemAt(data.items, 22) &&
        validItemAt(data.items, 23) &&
        validItemAt(data.items, 24) &&
        validItemAt(data.items, 25) &&
        validItemAt(data.items, 26) &&
        validItemAt(data.items, 27) &&
        validItemAt(data.items, 28) &&
        validItemAt(data.items, 29) &&
        validItemAt(data.items, 30) &&
        validItemAt(data.items, 31) &&
        validItemAt(data.items, 32) &&
        validItemAt(data.items, 33) &&
        validItemAt(data.items, 34) &&
        validItemAt(data.items, 35) &&
        validItemAt(data.items, 36) &&
        validItemAt(data.items, 37) &&
        validItemAt(data.items, 38) &&
        validItemAt(data.items, 39) &&
        validItemAt(data.items, 40) &&
        validItemAt(data.items, 41) &&
        validItemAt(data.items, 42) &&
        validItemAt(data.items, 43) &&
        validItemAt(data.items, 44) &&
        validItemAt(data.items, 45) &&
        validItemAt(data.items, 46) &&
        validItemAt(data.items, 47) &&
        validItemAt(data.items, 48) &&
        validItemAt(data.items, 49)
        && data.pricedTotal is number && data.pricedTotal >= 0
        && data.hasUnpricedItems is bool
        && data.createdAt is string
        && data.updatedAt is string;
    }

    match /orders/{orderId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn() && validNewOrder(request.resource.data);
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'paymentStatus', 'updatedAt'])
        && request.resource.data.status in [
             'Sent to store on WhatsApp', 'Confirmed by store',
             'Out for delivery', 'Delivered', 'Cancelled'
           ]
        && (!('paymentStatus' in request.resource.data)
            || request.resource.data.paymentStatus in ['Pending', 'Paid', 'Failed'])
        && request.resource.data.updatedAt is string;
      allow delete: if isAdmin();
    }

    // ---------------- everything else ----------------

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
